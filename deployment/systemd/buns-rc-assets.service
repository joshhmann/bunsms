[Unit]
Description=BunSMS TESTING RC immutable asset byte service
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/buns/rc-assets
Environment=ASSET_ONLY=1
Environment=PORT=8082
Environment=CLIENT_ASSETS_DIR=/opt/buns/rc-assets/registry
Environment=LAUNCHER_MANIFEST_PATH=/opt/buns/rc-assets/launcher-manifest.json
ExecStart=/usr/bin/python3 /opt/buns/rc-assets/server.py
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
