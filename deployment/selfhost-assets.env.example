# Copy to /etc/buns/assets.env, mode 0600. No credential values belong in git.
# Export/source the same file for docker compose --env-file /etc/buns/assets.env.
ASSET_BASE_URL=https://buns.asslorde.com
# Optional immutable sealed-candidate descriptor for isolated QA, without activation.
# Leave empty to follow the existing active server-wz.version authority.
WZ_VERSION_URL=
BUNS_ASSET_DIR=/opt/buns/client-assets
BUNS_MANIFEST_DIR=/opt/buns/manifest-writable
BUNS_CONTROL_DIR=/run/buns-control
BUNS_GAME_ASSET_STATE_DIR=/opt/buns/game-asset-state
ASSET_DIR=/opt/buns/client-assets
CLIENT_ASSETS_DIR=/opt/buns/client-assets
LAUNCHER_MANIFEST_PATH=/opt/buns/manifest-writable/launcher-manifest.json
GAME_CONTROL_SOCKET=/run/buns-control/control.sock
# Same credential contents in GM_API_SECRET (Next Edge middleware) and this file.
# Secret file: root:1001 mode0640 if mounted for dashboard file-based transport.
GM_API_SECRET=
GM_SECRET_FILE=/etc/buns/gm-api-secret
# Public native activation deferred by owner; this is not reachability proof.
# Isolated callers may explicitly override with 192.168.0.164 or 127.0.0.1.
GAME_CLIENT_HOST=buns.asslorde.com
GAME_SERVER_HOST=server
# Existing browser root, WSS port and native local baseline remain unchanged.
PORT=8080
# buns-private-deploy deploy-web creates/switches this matched static cohort.
STATIC_ROOT=/var/lib/buns/web-current
NX_DIR=/opt/buns/nx
ALLOWED_TARGETS=127.0.0.1:8484,127.0.0.1:7575,127.0.0.1:7576,127.0.0.1:7577
# Commands are JSON argv, not shell strings. No database or compose-wide restart.
GAME_RESTART_COMMAND='["/usr/bin/systemctl","restart","buns-game-apply.service"]'
NX_PREPARE_COMMAND='["/usr/bin/python3","/opt/buns/tools/prepare_nx_release.py"]'
# Trusted service origin, never caller-supplied; actual WASM proof must succeed.
NX_HTTP_ORIGIN=http://127.0.0.1:8080
NX_CONSUMER_VERIFY_COMMAND='["/usr/bin/python3","/opt/buns/tools/verify_nx_consumer.py"]'
# Capacity budgets use validated input corpus sizes; future outputs are estimates.
# Reserve cold converter build and filesystem metadata/log workspace in addition.
NX_CONVERTER_BUILD_RESERVE_BYTES=2147483648
NX_PREPARE_OVERHEAD_RESERVE_BYTES=536870912
# Clone https://github.com/joshhmann/bunsms.git and detach this actual source pin.
WZ_RELEASE_TOOLS_DIR=/opt/buns-wz-tools
WZ_RELEASE_TOOLS_COMMIT=776d80a49caadd2c9fc9552e9058948cc793b2df
# Immutable approved native PKG1 baseline, NOT the server XML WZ directory.
# Each baseline manifest: {"files":[{"name":"Base.wz","sha256":"...","size":123},...all16]}.
# Native may additionally declare List.wz/other flat WZ files; every row is verified/copied.
NATIVE_WZ_BASELINE_DIR=/opt/buns/native-wz-baseline
NATIVE_WZ_BASELINE_MANIFEST=/opt/buns/native-wz-baseline-manifest.json
# Actual observed complete16 deployed NX hashes. After first cohort commit the
# bridge snapshots committed nx/* objects instead of this initial local corpus.
NX_BASELINE_DIR=/opt/buns/nx
NX_BASELINE_MANIFEST=/opt/buns/nx-baseline-manifest.json
# Required ONLY when server baseline entries are missing, and for full image build.
# URL must be https://buns.asslorde.com/client/r/<sha256>/server-wz-baseline.tar.gz.
# Supply independently approved values; never use mutable tar URLs/R2 fallback.
WZ_BASELINE_URL=https://buns.asslorde.com/client/r/0139085a5542a638ca4a0c325203e36ab6d46d51fb2aac2fbebbfec2010b23ce/server-wz-baseline.tar.gz
WZ_BASELINE_HASH=0139085a5542a638ca4a0c325203e36ab6d46d51fb2aac2fbebbfec2010b23ce
WZ_BASELINE_SIZE=28469675
