diff --git a/src/client/Net/Handlers/Helpers/ShopParser.h b/src/client/Net/Handlers/Helpers/ShopParser.h
new file mode 100644
index 0000000..33b50e2
--- /dev/null
+++ b/src/client/Net/Handlers/Helpers/ShopParser.h
@@ -0,0 +1,132 @@
+//////////////////////////////////////////////////////////////////////////////
+// This file is part of the Journey MMORPG client                           //
+// Copyright © 2015-2016 Daniel Allendorf                                   //
+//                                                                          //
+// This program is free software: you can redistribute it and/or modify     //
+// it under the terms of the GNU Affero General Public License as           //
+// published by the Free Software Foundation, either version 3 of the       //
+// License, or (at your option) any later version.                          //
+//                                                                          //
+// This program is distributed in the hope that it will be useful,          //
+// but WITHOUT ANY WARRANTY; without even the implied warranty of           //
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the            //
+// GNU Affero General Public License for more details.                      //
+//                                                                          //
+// You should have received a copy of the GNU Affero General Public License //
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.    //
+//////////////////////////////////////////////////////////////////////////////
+#pragma once
+#include "../../InPacket.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace jrc
+{
+// NPC shop open layout shared by the live handler and native tests.
+//
+// Ground truth: server PacketCreator.getNPCShop writes npcid, item count,
+// then per item id/price/pitch-or-zero/time-zero/pad-int32/short flag.
+// Flag 1 (non-rechargeable) is followed by buyable; any other value is
+// followed by pad-int32 + recharge price (unit price bits) + slot max.
+// The live handler previously misread the rechargeable int32 pads as extra
+// items; this parser consumes the exact stride and fails truncated input.
+namespace ShopParser
+{
+    struct ShopEntry
+    {
+        int32_t itemid = 0;
+        int32_t price = 0;
+        int32_t pitch = 0;
+        int32_t time = 0;
+        int16_t rechargeprice = 0;
+        int16_t slotmax = 0;
+        int16_t buyable = 0;
+        bool rechargeable = false;
+    };
+
+    struct ShopOffer
+    {
+        int32_t npcid = 0;
+        std::vector<ShopEntry> items;
+    };
+
+    // v83 CONFIRM_SHOP_TRANSACTION result codes from Shop.buy/sell/recharge:
+    // 0 success, 1/5 out of stock (buyable/sellable mismatch), 2 insufficient
+    // mesos, 3 inventory full, 8 sell/recharge accepted. Code 0x0E crashes an
+    // unpatched client (short length). There is no buyback list in v83.
+    enum class ShopResult : int8_t
+    {
+        SUCCESS = 0,
+        OUT_OF_STOCK_1 = 1,
+        NO_MESOS = 2,
+        INVENTORY_FULL = 3,
+        OUT_OF_STOCK_5 = 5,
+        TRADE_FAILED_6 = 6,
+        TRADE_FAILED_7 = 7,
+        ACCEPTED_8 = 8
+    };
+
+    inline const char* result_message(int8_t code)
+    {
+        switch (code)
+        {
+        case 1:
+        case 5:
+            return "You don't have enough in stock.";
+        case 2:
+            return "You do not have enough mesos.";
+        case 3:
+            return "Please check if your inventory is full or not.";
+        case 6:
+        case 7:
+            return "Due to an error, the trade did not happen.";
+        default:
+            return nullptr;
+        }
+    }
+
+    inline bool parse_open_shop(InPacket& recv, ShopOffer& offer)
+    {
+        if (recv.length() < 6)
+            return false;
+        offer.npcid = recv.read_int();
+        int16_t size = recv.read_short();
+        if (size < 0)
+            return false;
+        offer.items.clear();
+        for (int16_t i = 0; i < size; ++i)
+        {
+            // id/price/pitch/time + pad int32 + short flag.
+            if (recv.length() < 22)
+                return false;
+            ShopEntry entry = {};
+            entry.itemid = recv.read_int();
+            entry.price = recv.read_int();
+            entry.pitch = recv.read_int();
+            entry.time = recv.read_int();
+            recv.skip(4);
+            int16_t flag = recv.read_short();
+            if (flag == 1)
+            {
+                if (recv.length() < 2)
+                    return false;
+                entry.buyable = recv.read_short();
+                entry.rechargeable = false;
+            }
+            else
+            {
+                if (recv.length() < 8)
+                    return false;
+                recv.skip(4);
+                entry.rechargeprice = recv.read_short();
+                entry.slotmax = recv.read_short();
+                entry.buyable = entry.slotmax;
+                entry.rechargeable = true;
+            }
+            offer.items.push_back(entry);
+        }
+        return true;
+    }
+} // namespace ShopParser
+} // namespace jrc
diff --git a/src/client/Net/Handlers/Helpers/StorageParser.h b/src/client/Net/Handlers/Helpers/StorageParser.h
new file mode 100644
index 0000000..bbea89b
--- /dev/null
+++ b/src/client/Net/Handlers/Helpers/StorageParser.h
@@ -0,0 +1,273 @@
+//////////////////////////////////////////////////////////////////////////////
+// This file is part of the Journey MMORPG client                           //
+// Copyright © 2015-2016 Daniel Allendorf                                   //
+//                                                                          //
+// This program is free software: you can redistribute it and/or modify     //
+// it under the terms of the GNU Affero General Public License as           //
+// published by the Free Software Foundation, either version 3 of the       //
+// License, or (at your option) any later version.                          //
+//                                                                          //
+// This program is distributed in the hope that it will be useful,          //
+// but WITHOUT ANY WARRANTY; without even the implied warranty of           //
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the            //
+// GNU Affero General Public License for more details.                      //
+//                                                                          //
+// You should have received a copy of the GNU Affero General Public License //
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.    //
+//////////////////////////////////////////////////////////////////////////////
+#pragma once
+#include "../../InPacket.h"
+#include "../../PacketError.h"
+
+#include "../../../Character/Inventory/InventoryType.h"
+#include "../../../Template/EnumMap.h"
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace jrc
+{
+// Storage (trunk) wire layout shared by the live handler and native tests.
+//
+// Ground truth: server PacketCreator.getStorage/storeStorage/takeOutStorage/
+// arrangeStorage/mesoStorage build addItemInfo(item, zeroPosition=true)
+// payloads; StorageProcessor.store validates quantity >= 1 and isFull,
+// take-out charges trunkGet and sends getStorageError(0x0A/0x0B/0x0C).
+// Display entries intentionally carry item id + stack count only; the
+// handler skips the remaining per-item stride without duplicating it into
+// UI state, so equip/non-equip strides stay aligned on the wire.
+namespace StorageParser
+{
+    struct ItemEntry
+    {
+        int32_t itemid = 0;
+        int16_t count = 0;
+    };
+
+    using ItemListByType = EnumMap<InventoryType::Id, std::vector<ItemEntry>>;
+
+    // Server InventoryType bitfield encoding: 2 << type (EQUIP=4, USE=8,
+    // SETUP=16, ETC=32, CASH=64). Unknown values map to NONE so the caller
+    // skips the tab update instead of misfiling items.
+    inline InventoryType::Id type_by_storage_bitfield(int16_t bitfield)
+    {
+        switch (bitfield)
+        {
+        case 4:
+            return InventoryType::EQUIP;
+        case 8:
+            return InventoryType::USE;
+        case 16:
+            return InventoryType::SETUP;
+        case 32:
+            return InventoryType::ETC;
+        case 64:
+            return InventoryType::CASH;
+        default:
+            return InventoryType::NONE;
+        }
+    }
+
+    // Parse one zeroPosition addItemInfo entry. The per-item stride is
+    // consumed exactly once: cash id, expiration, then the equip branch
+    // (upgrade slots + level, 14 stat shorts, owner, flags, cash/non-cash
+    // tail, expiration + serial) or the pet branch (name, level/tameness/
+    // fullness, tail) or the stackable branch (count, owner, flags,
+    // rechargeable tail). Returns false on truncation.
+    inline bool parse_item(InPacket& recv, InventoryType::Id forced_type,
+        InventoryType::Id& parsed_type, ItemEntry& entry)
+    {
+        size_t start = recv.length();
+        auto need = [&](size_t count) { return start >= count; };
+        auto take = [&](size_t count) {
+            if (!need(count))
+                return false;
+            recv.skip(count);
+            start -= count;
+            return true;
+        };
+
+        if (!need(1 + 4))
+            return false;
+        int8_t item_type = recv.read_byte();
+        int32_t item_id = recv.read_int();
+        start -= 1 + 4;
+
+        parsed_type = forced_type;
+        if (parsed_type == InventoryType::NONE)
+            parsed_type = InventoryType::by_item_id(item_id);
+
+        if (!need(1))
+            return false;
+        bool is_cash = recv.read_bool();
+        start -= 1;
+        if (is_cash && !take(8))
+            return false;
+        if (!take(8)) // expiration
+            return false;
+
+        entry = { item_id, 1 };
+
+        bool is_equip = parsed_type == InventoryType::EQUIP || item_type == 1;
+        bool is_pet = item_id >= 5000000 && item_id <= 5000102;
+
+        if (is_equip)
+        {
+            // upgrade slots + level, 14 stat shorts, owner, flags.
+            if (!take(2 + 28))
+                return false;
+            if (!need(2))
+                return false;
+            recv.read_string();
+            start = recv.length();
+            if (!take(2)) // flags
+                return false;
+            if (!take(is_cash ? 10 : 18))
+                return false;
+            if (!take(12)) // expiration + serial
+                return false;
+        }
+        else if (is_pet)
+        {
+            if (!need(13))
+                return false;
+            recv.read_padded_string(13);
+            start = recv.length();
+            if (!take(4 + 18))
+                return false;
+        }
+        else
+        {
+            if (!need(2))
+                return false;
+            entry.count = recv.read_short();
+            start -= 2;
+            if (!need(2))
+                return false;
+            recv.read_string();
+            start = recv.length();
+            if (!take(2)) // flags
+                return false;
+            bool rechargeable = item_id / 10000 == 207 || item_id / 10000 == 233;
+            if (rechargeable && !take(8))
+                return false;
+        }
+
+        return true;
+    }
+
+    // Parse a counted item run, filing entries by tab. Truncated runs fail
+    // instead of emitting partial tabs.
+    inline bool parse_items(InPacket& recv, uint8_t count,
+        InventoryType::Id forced_type, ItemListByType& parsed)
+    {
+        parsed = {};
+        for (size_t i = 0; i < count; ++i)
+        {
+            InventoryType::Id parsed_type = InventoryType::NONE;
+            ItemEntry entry = {};
+            if (!parse_item(recv, forced_type, parsed_type, entry))
+                return false;
+            if (parsed_type != InventoryType::NONE)
+                parsed[parsed_type].push_back(entry);
+        }
+        return true;
+    }
+
+    // Storage open frame (server mode 0x16): npcid, slot count, inventory
+    // mask + zeroes, stored mesos, counted zeroPosition items, trailer.
+    struct OpenStorage
+    {
+        int32_t npcid = 0;
+        uint8_t slots = 0;
+        int32_t meso = 0;
+        ItemListByType items;
+    };
+
+    inline bool parse_open(InPacket& recv, OpenStorage& open)
+    {
+        if (recv.length() < 4 + 1 + 2 + 2 + 4 + 4 + 2 + 1)
+            return false;
+        open.npcid = recv.read_int();
+        open.slots = static_cast<uint8_t>(recv.read_byte());
+        recv.skip(2); // inventory mask
+        recv.skip(2); // zero
+        recv.skip(4); // zero
+        open.meso = recv.read_int();
+        recv.skip(2); // zero
+        uint8_t count = static_cast<uint8_t>(recv.read_byte());
+        if (!parse_items(recv, count, InventoryType::NONE, open.items))
+            return false;
+        if (recv.length() >= 2)
+            recv.skip(2);
+        if (recv.length() >= 1)
+            recv.skip(1);
+        return true;
+    }
+
+    // Store/take-out tab refresh (server modes 0x0D/0x09): slot count, type
+    // bitfield, zeroes, then the counted items of that tab.
+    struct TabUpdate
+    {
+        uint8_t slots = 0;
+        InventoryType::Id type = InventoryType::NONE;
+        ItemListByType items;
+    };
+
+    inline bool parse_tab_update(InPacket& recv, TabUpdate& update)
+    {
+        if (recv.length() < 1 + 2 + 2 + 4 + 1)
+            return false;
+        update.slots = static_cast<uint8_t>(recv.read_byte());
+        update.type = type_by_storage_bitfield(recv.read_short());
+        recv.skip(2); // zero
+        recv.skip(4); // zero
+        uint8_t count = static_cast<uint8_t>(recv.read_byte());
+        return parse_items(recv, count, update.type, update.items);
+    }
+
+    // Sort result (server mode 0x0F): slot count, 0x7C mask, zeroes, then
+    // the counted items of every tab.
+    struct ArrangeResult
+    {
+        uint8_t slots = 0;
+        ItemListByType items;
+    };
+
+    inline bool parse_arrange(InPacket& recv, ArrangeResult& arranged)
+    {
+        if (recv.length() < 1 + 1 + 10 + 1)
+            return false;
+        arranged.slots = static_cast<uint8_t>(recv.read_byte());
+        recv.skip(1);  // 0x7C mask
+        recv.skip(10); // zeroes
+        uint8_t count = static_cast<uint8_t>(recv.read_byte());
+        if (!parse_items(recv, count, InventoryType::NONE, arranged.items))
+            return false;
+        if (recv.length() >= 1)
+            recv.skip(1);
+        return true;
+    }
+
+    // Storage result codes surfaced by the server: 0x0A inventory full,
+    // 0x0B insufficient mesos, 0x0C one-of-a-kind, 0x11 storage full.
+    // Returns the notice text, or nullptr when the mode is not an error.
+    inline const char* error_message(int8_t mode)
+    {
+        switch (mode)
+        {
+        case 0x0A:
+            return "Your inventory is full.";
+        case 0x0B:
+            return "You do not have enough mesos.";
+        case 0x0C:
+            return "This item cannot be moved from storage.";
+        case 0x11:
+            return "Storage is full.";
+        default:
+            return nullptr;
+        }
+    }
+} // namespace StorageParser
+} // namespace jrc
