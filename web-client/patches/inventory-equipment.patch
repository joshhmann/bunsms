+    const char* UIItemInventory::equip_refusal_for(int32_t item_id)
+    {
+        const EquipData& data = EquipData::get(item_id);
+        if (!data)
+            return nullptr;
+
+        const CharStats& stats = Stage::get().get_player().get_stats();
+        EquipGate::Stats have = {
+            stats.get_stat(Maplestat::LEVEL),
+            stats.get_stat(Maplestat::JOB),
+            stats.get_stat(Maplestat::STR),
+            stats.get_stat(Maplestat::DEX),
+            stats.get_stat(Maplestat::INT),
+            stats.get_stat(Maplestat::LUK)
+        };
+        EquipGate::Reqs need = {
+            data.get_reqstat(Maplestat::LEVEL),
+            data.get_reqstat(Maplestat::STR),
+            data.get_reqstat(Maplestat::DEX),
+            data.get_reqstat(Maplestat::INT),
+            data.get_reqstat(Maplestat::LUK),
+            data.get_reqstat(Maplestat::JOB)
+        };
+        return EquipGate::check(have, need);
+    }
+
+    const char* UIItemInventory::equip_refusal(int32_t item_id) const
+    {
+        return equip_refusal_for(item_id);
+    }
