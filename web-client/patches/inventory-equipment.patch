+#pragma once
+#include <cstdint>
+
+namespace jrc
+{
+// Client-side mirror of the server equip requirement gate, over plain
+// requirement values so native tests link without renderer/NX assets.
+//
+// Ground truth: server ItemInformationProvider.canWearEquipment(chr, equip,
+// dst) requires the destination slot to be allowed for the item, then level
+// and STR/DEX/INT/LUK/fame against totals including currently equipped
+// items. The client renders the same row red/green in EquipTooltip (which
+// compares CharStats base stats against EquipData reqstats, plus the WZ
+// reqJob mapping). This gate takes base stats, so it can only refuse early
+// (never force acceptance): anything it passes still goes to the server,
+// which remains authoritative and replies enableActions on rejection.
+//
+// Returns the first unmet requirement name, or nullptr when the equip may
+// be dispatched. Unknown job codes fail closed, mirroring how the tooltip
+// renders them unequippable, rather than dispatching a doomed request.
+// GM jobs (900/910) pass: the server bypasses requirements for those and
+// this gate must not invent rejections.
+namespace EquipGate
+{
+    struct Reqs
+    {
+        int16_t level = 0;
+        int16_t str = 0;
+        int16_t dex = 0;
+        int16_t intel = 0;
+        int16_t luk = 0;
+        int16_t job = 0;
+    };
+
+    struct Stats
+    {
+        uint16_t level = 0;
+        uint16_t job = 0;
+        uint16_t str = 0;
+        uint16_t dex = 0;
+        uint16_t intel = 0;
+        uint16_t luk = 0;
+    };
+
+    // WZ reqJob mapping mirrors EquipTooltip::load: 0 common, 1 warrior,
+    // 2 magician, 3 warrior/magician, 4 bowman, 8 thief, 16 pirate.
+    // GM jobs pass earlier; the /100 bands below match tooltip job ids
+    // 1..5 (warrior/magician/bowman/thief/pirate).
+    inline bool job_allowed(int16_t reqjob, uint16_t job)
+    {
+        uint16_t branch = job / 100;
+        switch (reqjob)
+        {
+        case 0:
+            return true;
+        case 1:
+            return branch == 1 || branch >= 20;
+        case 2:
+            return branch == 2;
+        case 3:
+            return branch == 1 || branch == 2 || branch >= 20;
+        case 4:
+            return branch == 3;
+        case 8:
+            return branch == 4;
+        case 16:
+            return branch == 5;
+        default:
+            return false;
+        }
+    }
+
+    inline const char* check(const Stats& stats, const Reqs& reqs)
+    {
+        if (stats.job == 900 || stats.job == 910)
+            return nullptr;
+
+        if (stats.level < reqs.level)
+            return "level";
+        if (stats.str < reqs.str)
+            return "STR";
+        if (stats.dex < reqs.dex)
+            return "DEX";
+        if (stats.intel < reqs.intel)
+            return "INT";
+        if (stats.luk < reqs.luk)
+            return "LUK";
+        if (!job_allowed(reqs.job, stats.job))
+            return "job";
+
+        return nullptr;
+    }
+}
+}
