diff --git a/src/client/Gameplay/RemoteMovement.h b/src/client/Gameplay/RemoteMovement.h
new file mode 100644
index 0000000..175da9d
--- /dev/null
+++ b/src/client/Gameplay/RemoteMovement.h
@@ -0,0 +1,102 @@
+#pragma once
+#include "Movement.h"
+
+#include <algorithm>
+#include <queue>
+#include <vector>
+
+namespace jrc
+{
+    // Movement fragments describe a timeline in milliseconds, not update counts.
+    class RemoteMovement
+    {
+    public:
+        explicit RemoteMovement(uint8_t initialstate) : state(initialstate) {}
+
+        void enqueue(const std::vector<Movement>& fragments)
+        {
+            for (const auto& fragment : fragments)
+            {
+                if (fragment.type != Movement::NONE)
+                    pending.push(fragment);
+            }
+        }
+
+        void advance(PhysicsObject& object, uint16_t elapsed)
+        {
+            double x = object.crnt_x();
+            double y = object.crnt_y();
+
+            while (true)
+            {
+                if (remaining == 0)
+                {
+                    if (pending.empty())
+                        break;
+
+                    current = pending.front();
+                    pending.pop();
+                    state = current.newstate;
+                    remaining = current.duration;
+
+                    if (current.type == Movement::TELEPORT || remaining == 0)
+                    {
+                        if (current.type != Movement::_RELATIVE)
+                        {
+                            x = current.xpos;
+                            y = current.ypos;
+                            // An instantaneous fragment must not draw a path from
+                            // the old location through render-time interpolation.
+                            object.set_x(x);
+                            object.set_y(y);
+                        }
+                        if (current.type == Movement::_ABSOLUTE || current.type == Movement::JUMPDOWN)
+                            object.fhid = current.fh;
+                        remaining = 0;
+                        continue;
+                    }
+                }
+
+                if (elapsed == 0)
+                    break;
+
+                uint16_t step = std::min(elapsed, remaining);
+                if (current.type == Movement::_RELATIVE)
+                {
+                    // Relative fragments carry velocity in pixels per second.
+                    x += current.xpos * (static_cast<double>(step) / 1000.0);
+                    y += current.ypos * (static_cast<double>(step) / 1000.0);
+                }
+                else
+                {
+                    double fraction = static_cast<double>(step) / remaining;
+                    x += (current.xpos - x) * fraction;
+                    y += (current.ypos - y) * fraction;
+                }
+
+                elapsed -= step;
+                remaining -= step;
+                if (remaining == 0 && current.type != Movement::_RELATIVE)
+                {
+                    x = current.xpos;
+                    y = current.ypos;
+                    object.fhid = current.fh;
+                }
+            }
+
+            // Move once per physics update, so Linear's previous/current values
+            // remain the endpoints of this update even across fragment boundaries.
+            object.hspeed = x - object.crnt_x();
+            object.vspeed = y - object.crnt_y();
+            object.move();
+        }
+
+        uint8_t get_state() const { return state; }
+
+    private:
+        std::queue<Movement> pending;
+        Movement current;
+        uint16_t remaining = 0;
+        uint8_t state;
+    };
+}
