diff --git a/src/client/HudLayout.h b/src/client/HudLayout.h
new file mode 100644
index 0000000..ebc40ab
--- /dev/null
+++ b/src/client/HudLayout.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "Template/Rectangle.h"
+
+#include <algorithm>
+#include <cstdint>
+
+namespace jrc
+{
+    namespace HudLayout
+    {
+        // StatusBar2/mainBar/backgrnd is 1366x85, with origin (512,84).
+        // Its right-hand slot grid is baked artwork, not interactive quickslots.
+        constexpr int16_t CORE_WIDTH = 800;
+        constexpr int16_t ART_WIDTH = 1366;
+        constexpr int16_t ART_HEIGHT = 85;
+        constexpr int16_t GRID_LEFT = 876;
+        constexpr int16_t GRID_WIDTH = ART_WIDTH - GRID_LEFT;
+        constexpr int16_t CHAT_RIGHT = 516;
+
+        struct Status
+        {
+            Point<int16_t> anchor;
+            Rectangle<int16_t> core;
+            Rectangle<int16_t> grid;
+            Point<int16_t> trade_offset;
+        };
+
+        inline int16_t chat_left(Point<int16_t> anchor)
+        {
+            return anchor.x() - 512;
+        }
+
+        inline Status status(int16_t width, int16_t height, int16_t yoffset)
+        {
+            const int16_t bottom = height - yoffset - 1;
+            const bool inline_grid = width >= ART_WIDTH;
+            const int16_t left = (width - (inline_grid ? ART_WIDTH : CORE_WIDTH)) / 2;
+            Status layout;
+            layout.anchor = { static_cast<int16_t>(left + 512), bottom };
+            layout.core = { left, static_cast<int16_t>(left + CORE_WIDTH),
+                static_cast<int16_t>(bottom - 84), static_cast<int16_t>(bottom + 1) };
+            if (inline_grid)
+            {
+                layout.grid = { static_cast<int16_t>(left + GRID_LEFT),
+                    static_cast<int16_t>(left + ART_WIDTH),
+                    static_cast<int16_t>(bottom - 84), static_cast<int16_t>(bottom + 1) };
+                // BtMTS otherwise overlaps both BtCashShop and BtMenu.
+                layout.trade_offset = { 183, 0 };
+            }
+            else
+            {
+                // Keep the grid clear of even a fully expanded chat panel and the
+                // extra trade button. Only decorative art scales; controls stay native size.
+                const int16_t grid_width = std::min<int16_t>(GRID_WIDTH,
+                    width - left - CHAT_RIGHT - 8);
+                const int16_t grid_height = ART_HEIGHT * grid_width / GRID_WIDTH;
+                layout.grid = { static_cast<int16_t>(width - grid_width), width,
+                    static_cast<int16_t>(bottom - 106 - grid_height),
+                    static_cast<int16_t>(bottom - 106) };
+                layout.trade_offset = { -103, -62 };
+            }
+            return layout;
+        }
+    }
+}
