+                (screen_height - top.height() - bottom.height() - 40) / fill.height());
+            vtile = static_cast<int16_t>(std::min(wanted, available));
+            height = vtile * fill.height();
+            dimension = { top.width(), static_cast<int16_t>(top.height() + height + bottom.height()) };
+            max_scroll = static_cast<int16_t>(std::max<int>(0, content - height + TEXT_VERTICAL_PADDING * 2));
+            scroll_offset = std::min(scroll_offset, max_scroll);
+            for (auto& button : buttons)
+            {
+                auto visible = button.second->bounds({}).getlt();
+                button.second->set_position({});
+                auto origin = button.second->bounds({}).getlt();
+                visible.shift_y(height - old_height);
