diff --git a/src/client/IO/Components/PicEntry.h b/src/client/IO/Components/PicEntry.h
new file mode 100644
index 0000000..dd9aa0f
--- /dev/null
+++ b/src/client/IO/Components/PicEntry.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <string>
+
+namespace jrc
+{
+    // PIC entry never submits a default; registration requires matching entries.
+    class PicEntry
+    {
+    public:
+        enum class Result { INCOMPLETE, CONFIRM, MISMATCH, ACCEPTED };
+        explicit PicEntry(bool registration = false) : registration(registration) {}
+        void append(unsigned digit)
+        {
+            if (digit < 10 && value.size() < 12)
+                value.push_back(static_cast<char>('0' + digit));
+        }
+        void erase()
+        {
+            if (!value.empty()) value.pop_back();
+        }
+        bool ready() const { return value.size() >= 4; }
+        bool full() const { return value.size() == 12; }
+        std::string masked() const { return std::string(value.size(), '*'); }
+        const std::string& input() const { return value; }
+        Result submit()
+        {
+            if (!ready()) return Result::INCOMPLETE;
+            if (!registration) return Result::ACCEPTED;
+            if (first.empty())
+            {
+                first = value;
+                value.clear();
+                return Result::CONFIRM;
+            }
+            if (first == value) return Result::ACCEPTED;
+            first.clear();
+            value.clear();
+            return Result::MISMATCH;
+        }
+    private:
+        bool registration;
+        std::string value;
+        std::string first;
+    };
+}
