+    // The v83 PacketCreator/NPCMoreTalkHandler contract, independent of art/UI.
+    struct NpcDialogue
+    {
+        enum class Mode { TEXT, YES_NO, TEXTFIELD, NUMBER, SELECTION, STYLE, ACCEPT_DECLINE };
+        int32_t npc = 0;
+        int8_t type = 0;
+        int8_t speaker = 0;
+        Mode mode = Mode::TEXT;
+        std::string text;
+        std::string default_text;
+        int32_t number_default = 0;
+        int32_t number_min = 0;
+        int32_t number_max = 0;
+        uint16_t text_min = 0;
+        uint16_t text_max = 100;
+        bool navigation = false;
+        bool previous = false;
+        bool next = false;
+        std::vector<int32_t> styles;
+
+        // Mirror uses #index#label, not the ordinary #Lindex#label#l menu.
+        // Normalize only this packet type before the existing UI token parser.
+        static std::string mirror_text(const std::string& source)
+        {
+            std::string result;
+            size_t cursor = 0;
+            while (cursor < source.size())
+            {
+                size_t start = source.find('#', cursor);
+                if (start == std::string::npos)
+                {
+                    result += source.substr(cursor);
+                    break;
+                }
+                result += source.substr(cursor, start - cursor);
+                size_t end = source.find('#', start + 1);
+                if (end == std::string::npos)
+                    throw PacketError("Invalid dimensional mirror option");
+                int32_t id = 0;
+                auto parsed = std::from_chars(source.data() + start + 1, source.data() + end, id);
+                if (parsed.ec != std::errc() || parsed.ptr != source.data() + end)
+                    throw PacketError("Invalid dimensional mirror option");
+                size_t next = source.find('#', end + 1);
+                std::string label = source.substr(end + 1, next == std::string::npos ?
+                    std::string::npos : next - end - 1);
+                if (id >= 0)
+                    result += "#L" + std::to_string(id) + "#" + label + "#l";
+                else
+                    result += label; // #-1# means no destination, not acceptance.
+                if (next == std::string::npos)
+                    break;
+                cursor = next;
+            }
+            return result;
+        }
+
+        static NpcDialogue parse(InPacket& packet)
+        {
+            NpcDialogue result;
+            packet.read_byte();
+            result.npc = packet.read_int();
+            result.type = packet.read_byte();
+            result.speaker = packet.read_byte();
+
+            // Speed quiz 7 is NOT getNPCTalkStyle: [result][five int32s]
+            // (or just [result] on failure). Reject instead of interpreting its
+            // binary payload as a string/style count. Quiz support is separate.
+            if (result.type == 6 || (result.type == 7 &&
+                (packet.length() == 1 || (packet.length() == 21 && packet.inspect_byte() == 0))))
+                throw PacketError("Unsupported NPC quiz dialogue");
+            if (result.type == 14)
+                packet.read_int(); // getDimensionalMirror's reserved int precedes the string.
+            result.text = packet.read_string();
+            if (result.type == 14)
+                result.text = mirror_text(result.text);
+            switch (result.type)
+            {
+            case 0:
+                result.mode = Mode::TEXT;
+                result.navigation = true;
+                result.previous = packet.read_bool();
+                result.next = packet.read_bool();
+                break;
+            case 1:
+                // Retain the deployed navigation-bearing type1 variant.
+                result.mode = Mode::YES_NO;
+                if (packet.length() == 2)
+                {
+                    result.mode = Mode::TEXT;
+                    result.navigation = true;
+                    result.previous = packet.read_bool();
+                    result.next = packet.read_bool();
+                }
+                break;
+            case 2:
+            {
+                result.mode = Mode::TEXTFIELD;
+                result.default_text = packet.read_string();
+                result.text_min = static_cast<uint16_t>(packet.read_short());
+                uint16_t maximum = static_cast<uint16_t>(packet.read_short());
+                result.text_max = maximum == 0 ? 100 : maximum;
+                if (result.text_min > result.text_max ||
+                    result.default_text.size() > result.text_max)
+                    throw PacketError("Invalid NPC text bounds/default");
+                break;
+            }
+            case 3:
+                result.mode = Mode::NUMBER;
+                result.number_default = packet.read_int();
+                result.number_min = packet.read_int();
+                result.number_max = packet.read_int();
+                packet.read_int(); // PacketCreator's reserved trailer.
+                if (result.number_min > result.number_max || result.number_default < result.number_min ||
+                    result.number_default > result.number_max)
+                    throw PacketError("Invalid NPC number bounds/default");
+                break;
+            case 4:
+            case 5:
+            case 14:
+                result.mode = Mode::SELECTION;
+                break;
+            case 7:
+            {
+                result.mode = Mode::STYLE;
+                uint8_t count = static_cast<uint8_t>(packet.read_byte());
+                if (count == 0 || packet.length() != static_cast<size_t>(count) * 4)
+                    throw PacketError("Invalid NPC style count");
+                result.styles.reserve(count);
+                for (uint16_t i = 0; i < count; ++i)
+                    result.styles.push_back(packet.read_int());
+                break;
+            }
+            case 12:
+                result.mode = Mode::ACCEPT_DECLINE;
+                break;
+            default:
+                throw PacketError("Unsupported NPC dialogue type " + std::to_string(result.type));
+            }
+            if (packet.available())
+                throw PacketError("Unexpected NPC dialogue trailer");
+            return result;
+        }
+    };
+
+    class NpcDialogueState
+    {
+    public:
+        enum class Action { CONFIRM, YES, NO, BACK, NEXT, CANCEL };
+
+        void begin(NpcDialogue dialogue)
+        {
+            current = std::move(dialogue);
+            responded = false;
+            error_message.clear();
+            options.clear();
+        }
+        const NpcDialogue& dialogue() const { return current; }
+        void set_options(const std::vector<int32_t>& values) { options = values; }
+        const std::string& error() const { return error_message; }
+
+        std::optional<NpcTalkMorePacket> respond(Action action, const std::string& input = {}, int32_t index = 0)
+        {
+            if (responded)
+                return std::nullopt;
+            error_message.clear();
+            std::optional<NpcTalkMorePacket> packet;
+            if (action == Action::CANCEL)
+                packet = NpcTalkMorePacket::close(current.type);
+            else if (action == Action::BACK && current.mode == NpcDialogue::Mode::TEXT && current.previous)
+                packet = NpcTalkMorePacket(current.type, 0);
+            else if (action == Action::NEXT && current.mode == NpcDialogue::Mode::TEXT && current.next)
+                packet = NpcTalkMorePacket(current.type, 1);
+            else if ((action == Action::YES || action == Action::NO) &&
+                (current.mode == NpcDialogue::Mode::YES_NO || current.mode == NpcDialogue::Mode::ACCEPT_DECLINE))
+                packet = NpcTalkMorePacket(current.type, action == Action::YES ? 1 : 0);
+            else if (action == Action::CONFIRM)
+            {
+                switch (current.mode)
+                {
+                case NpcDialogue::Mode::NUMBER:
+                {
+                    int32_t value = 0;
+                    const auto parsed = std::from_chars(input.data(), input.data() + input.size(), value);
+                    if (input.empty() || parsed.ec != std::errc() || parsed.ptr != input.data() + input.size() ||
+                        value < current.number_min || value > current.number_max)
+                        error_message = "Enter a whole number from " + std::to_string(current.number_min) +
+                            " to " + std::to_string(current.number_max) + ".";
+                    else
+                        packet = NpcTalkMorePacket::number(1, value);
+                    break;
+                }
+                case NpcDialogue::Mode::TEXTFIELD:
+                    if (input.size() < current.text_min || input.size() > current.text_max)
+                        error_message = "Enter between " + std::to_string(current.text_min) + " and " +
+                            std::to_string(current.text_max) + " characters.";
+                    else
+                        packet = NpcTalkMorePacket(input);
+                    break;
+                case NpcDialogue::Mode::STYLE:
+                    if (index >= 0 && static_cast<size_t>(index) < current.styles.size())
+                        packet = NpcTalkMorePacket::style(static_cast<uint8_t>(index));
+                    break;
+                case NpcDialogue::Mode::SELECTION:
+                    if (index >= 0 && static_cast<size_t>(index) < options.size())
+                        packet = NpcTalkMorePacket::selection(current.type, options[index]);
+                    break;
+                case NpcDialogue::Mode::TEXT:
+                    packet = NpcTalkMorePacket(current.type, 1);
+                    break;
+                default:
+                    break;
+                }
+            }
+            if (packet)
+                responded = true;
+            return packet;
+        }
+
+    private:
+        NpcDialogue current;
+        std::vector<int32_t> options;
+        bool responded = true;
+        std::string error_message;
+    };
+}
