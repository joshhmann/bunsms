diff --git a/src/client/Viewport.h b/src/client/Viewport.h
new file mode 100644
index 0000000..3acce1b
--- /dev/null
+++ b/src/client/Viewport.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include "Template/Point.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace jrc
+{
+    // All UI/world geometry is logical pixels. Only the GL viewport uses backing pixels.
+    namespace Viewport
+    {
+        // Coverage is authored map/art extent, never the current camera or browser size.
+        // Unknown or insufficient coverage retains the original game's classic view.
+        inline Point<int16_t> supported_view(Point<int16_t> requested, Point<int32_t> coverage)
+        {
+            if (requested.x() >= 1920 && requested.y() >= 1080 &&
+                coverage.x() >= 1920 && coverage.y() >= 1080)
+                return {1920, 1080};
+            if (requested.x() >= 1280 && requested.y() >= 720 &&
+                coverage.x() >= 1280 && coverage.y() >= 720)
+                return {1280, 720};
+            return {800, 600};
+        }
+
+        inline Point<int16_t> input_position(double x, double y, int32_t window_width,
+            int32_t window_height, int16_t logical_width, int16_t logical_height,
+            int16_t yoffset)
+        {
+            const double lx = x * logical_width / std::max(1, window_width);
+            const double ly = y * logical_height / std::max(1, window_height) - yoffset;
+            return {
+                static_cast<int16_t>(std::clamp(lx, -32768.0, 32767.0)),
+                static_cast<int16_t>(std::clamp(ly, -32768.0, 32767.0))
+            };
+        }
+
+        inline Point<int16_t> clamp_window(Point<int16_t> position, Point<int16_t> size,
+            int16_t width, int16_t height, int16_t yoffset)
+        {
+            // Oversized windows retain their title/close controls at the top edge.
+            const int32_t max_x = std::max<int32_t>(0, width - size.x());
+            const int32_t max_y = std::max<int32_t>(-yoffset, height - yoffset - size.y());
+            return {
+                static_cast<int16_t>(std::clamp<int32_t>(position.x(), 0, max_x)),
+                static_cast<int16_t>(std::clamp<int32_t>(position.y(), -yoffset, max_y))
+            };
+        }
+
+        inline double camera_axis(double offset, int16_t negative_first,
+            int16_t negative_second, int16_t extent)
+        {
+            const double lower = std::min(negative_first, negative_second);
+            const double upper = std::max(negative_first, negative_second);
+            if (upper - lower <= extent)
+            {
+                return (lower + upper + extent) / 2.0;
+            }
+            return std::clamp(offset, lower + extent, upper);
+        }
+    }
+}
