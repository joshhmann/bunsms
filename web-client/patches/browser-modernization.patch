diff --git a/src/client/IO/WorldInputState.h b/src/client/IO/WorldInputState.h
new file mode 100644
index 0000000..a8a9a3d
--- /dev/null
+++ b/src/client/IO/WorldInputState.h
@@ -0,0 +1,73 @@
+#pragma once
+#include "Keyboard.h"
+
+#include <array>
+#include <cstddef>
+
+namespace jrc
+{
+    // Tracks only inputs actually delivered to the world. Suspended keys remain
+    // quarantined until key-up, so OS repeats cannot restart motion after a modal.
+    class WorldInputState
+    {
+    public:
+        template <typename Send>
+        void send(KeyType::Id type, int32_t action, bool pressed, bool blocked, Send&& deliver)
+        {
+            if (type != KeyType::ACTION && type != KeyType::FACE &&
+                type != KeyType::ITEM && type != KeyType::SKILL)
+                return;
+            // Only ACTION has held/release semantics in Stage::send_key.
+            // Releasing ITEM/SKILL/FACE would execute the command again.
+            if (type != KeyType::ACTION)
+            {
+                if (pressed && !blocked)
+                    deliver(type, action, true);
+                return;
+            }
+            size_t index = 0;
+            while (index < count && !(held[index].key == Keyboard::Mapping(type, action)))
+                ++index;
+            if (!pressed)
+            {
+                if (index < count)
+                {
+                    if (!held[index].suspended)
+                        deliver(type, action, false);
+                    held[index] = held[--count];
+                }
+                return;
+            }
+            if (index < count)
+            {
+                if (!blocked && !held[index].suspended)
+                    deliver(type, action, true);
+                return;
+            }
+            if (count == held.size())
+                return;
+            held[count++] = { Keyboard::Mapping(type, action), blocked };
+            if (!blocked)
+                deliver(type, action, true);
+        }
+
+        template <typename Send>
+        void suspend(Send&& deliver)
+        {
+            for (size_t i = 0; i < count; ++i)
+            {
+                if (!held[i].suspended)
+                {
+                    held[i].suspended = true;
+                    deliver(held[i].key.type, held[i].key.action, false);
+                }
+            }
+        }
+
+    private:
+        struct Held { Keyboard::Mapping key; bool suspended = false; };
+        // At most one held mapping per GLFW key. No allocation on input events.
+        std::array<Held, 512> held = {};
+        size_t count = 0;
+    };
+}
