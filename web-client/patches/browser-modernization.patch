+                textfield.set_bounds({ DIALOG_TEXT_X, DIALOG_TEXT_X + TEXT_WIDTH, y,
+                    static_cast<int16_t>(y + TEXTFIELD_HEIGHT) });
+            }
+        }
+        position = { static_cast<int16_t>(std::max<int>(0, (width - dimension.x()) / 2)),
+                     static_cast<int16_t>(std::max<int>(0, (screen_height - dimension.y()) / 2)) };
+        if (show_textfield)
