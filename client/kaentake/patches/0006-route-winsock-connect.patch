+static int WSAAPI Connect_hook(SOCKET socket, const sockaddr* address, int length) {
+    if (!address || length < sizeof(sockaddr_in) || address->sa_family != AF_INET)
+        return Connect_orig(socket, address, length);
+    const auto* original = reinterpret_cast<const sockaddr_in*>(address);
+    const auto& bytes = original->sin_addr.S_un.S_un_b;
+    if (bytes.s_b1 != 63 || bytes.s_b2 != 251 || bytes.s_b3 != 217 || bytes.s_b4 < 2 || bytes.s_b4 > 4)
+        return Connect_orig(socket, address, length);
+    const auto& server = ResolveServerAddress();
+    if (server.error) {
+        WSASetLastError(server.error);
+        return SOCKET_ERROR;
+    }
+    if (!RememberRedirect(socket, original->sin_addr.S_un.S_addr)) {
+        WSASetLastError(WSAENOBUFS);
+        return SOCKET_ERROR;
+    }
+    sockaddr_in redirected = *original;
+    redirected.sin_addr = server.address;
+    if (g_nServerPort) redirected.sin_port = htons(static_cast<u_short>(g_nServerPort));
+    const int result = Connect_orig(socket, reinterpret_cast<const sockaddr*>(&redirected), sizeof(redirected));
+    const int error = WSAGetLastError();
+    if (result == SOCKET_ERROR && error != WSAEWOULDBLOCK && error != WSAEINPROGRESS && error != WSAEALREADY)
+        ForgetRedirect(socket);
+    WSASetLastError(error);
     return result;
