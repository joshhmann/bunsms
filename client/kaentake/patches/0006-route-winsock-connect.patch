+static int WSAAPI GetPeerName_hook(SOCKET socket, sockaddr* address, int* length) {
+    const int result = GetPeerName_orig(socket, address, length);
+    const int error = WSAGetLastError();
+    if (result == 0 && address && length && *length >= sizeof(sockaddr_in) && address->sa_family == AF_INET) {
+        ULONG original;
+        if (OriginalPeerAddress(socket, original))
