+// Own the actual Winsock API path. SPI provider startup is not a reliable
+// interception seam on every supported runtime (including Wine).
+static decltype(&connect) Connect_orig = &connect;
+static decltype(&getpeername) GetPeerName_orig = &getpeername;
+static decltype(&closesocket) CloseSocket_orig = &closesocket;
+
+struct RedirectedPeer {
+    SOCKET socket;
+    ULONG originalAddress;
+    RedirectedPeer* next;
 };
+static SRWLOCK g_peerLock = SRWLOCK_INIT;
+static RedirectedPeer* g_redirectedPeers = nullptr;
+
+// POD process-lifetime state: hooks remain installed while other DLLs detach.
+// Allocate only when a newly redirected socket needs peer identity storage.
+static bool RememberRedirect(SOCKET socket, ULONG address) {
+    AcquireSRWLockExclusive(&g_peerLock);
+    for (auto* peer = g_redirectedPeers; peer; peer = peer->next) {
+        if (peer->socket == socket) {
+            peer->originalAddress = address;
+            ReleaseSRWLockExclusive(&g_peerLock);
+            return true;
+        }
+    }
+    auto* peer = static_cast<RedirectedPeer*>(HeapAlloc(GetProcessHeap(), 0, sizeof(RedirectedPeer)));
+    if (peer) {
+        *peer = {socket, address, g_redirectedPeers};
+        g_redirectedPeers = peer;
+    }
+    ReleaseSRWLockExclusive(&g_peerLock);
+    return peer != nullptr;
+}
+
+static void ForgetRedirect(SOCKET socket) {
+    AcquireSRWLockExclusive(&g_peerLock);
+    auto** position = &g_redirectedPeers;
+    while (*position) {
+        if ((*position)->socket == socket) {
+            auto* removed = *position;
+            *position = removed->next;
+            HeapFree(GetProcessHeap(), 0, removed);
+            break;
+        }
+        position = &(*position)->next;
+    }
+    ReleaseSRWLockExclusive(&g_peerLock);
+}
+
+static bool OriginalPeerAddress(SOCKET socket, ULONG& address) {
+    bool found = false;
+    AcquireSRWLockShared(&g_peerLock);
+    for (auto* peer = g_redirectedPeers; peer; peer = peer->next) {
+        if (peer->socket == socket) {
+            address = peer->originalAddress;
+            found = true;
+            break;
+        }
+    }
+    ReleaseSRWLockShared(&g_peerLock);
+    return found;
+}
 
