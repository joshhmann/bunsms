+    WSASetLastError(error);
     return result;
+}
+
+static int WSAAPI CloseSocket_hook(SOCKET socket) {
+    const int result = CloseSocket_orig(socket);
+    const int error = WSAGetLastError();
+    if (result == 0) ForgetRedirect(socket);
+    WSASetLastError(error);
+    return result;
+}
+
+static void InstallRoutingHooks() {
+    if (!ATTACH_HOOK(Connect_orig, Connect_hook) ||
+        !ATTACH_HOOK(GetPeerName_orig, GetPeerName_hook) ||
+        !ATTACH_HOOK(CloseSocket_orig, CloseSocket_hook)) {
+        // Post-unpack/main-thread seam: never a modal or network work in DllMain.
+        ErrorMessage("Could not install required Winsock routing hooks.");
+        ExitProcess(ERROR_DLL_INIT_FAILED);
+    }
 }
