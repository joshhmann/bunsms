+struct ServerAddress {
+    IN_ADDR address{};
+    int error = 0;
+};
+
+static const ServerAddress& ResolveServerAddress() {
+    // Configuration is fixed before hooks attach. Resolve once per process,
+    // outside DllMain; literal QA overrides do not allocate resolver results.
+    static const ServerAddress resolved = [] {
+        ServerAddress server;
+        const char* host = g_sServerHost ? g_sServerHost : CONSTANTS_DEFAULT_HOST;
+        if (InetPtonA(AF_INET, host, &server.address) == 1) {
+            return server;
+        }
+        ADDRINFOA hints{};
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_STREAM;
+        hints.ai_protocol = IPPROTO_TCP;
+        ADDRINFOA* results = nullptr;
+        server.error = getaddrinfo(host, nullptr, &hints, &results);
+        if (!server.error) {
+            if (results && results->ai_addrlen >= sizeof(sockaddr_in)) {
+                server.address = reinterpret_cast<const sockaddr_in*>(results->ai_addr)->sin_addr;
+            } else {
+                server.error = WSAHOST_NOT_FOUND;
+            }
+        }
+        if (results) freeaddrinfo(results);
+        return server;
+    }();
+    return resolved;
+}
