+static int TraceConnect(SOCKET socket, const sockaddr* address, int length) {
+    static volatile LONG count = 0;
+    const bool trace = InterlockedIncrement(&count) <= 16;
+    if (trace && address && length >= sizeof(sockaddr_in) && address->sa_family == AF_INET) {
+        const int savedError = WSAGetLastError();
+        const auto* ipv4 = reinterpret_cast<const sockaddr_in*>(address);
+        WSAPROTOCOL_INFOA provider{};
+        int providerLength = sizeof(provider);
+        const int providerResult = getsockopt(socket, SOL_SOCKET, SO_PROTOCOL_INFOA,
+            reinterpret_cast<char*>(&provider), &providerLength);
+        const auto& bytes = ipv4->sin_addr.S_un.S_un_b;
+        DebugMessage("BUNS_RUNTIME client-socket-connect destination=%u.%u.%u.%u port=%u provider-result=%d provider=%s\n",
+            bytes.s_b1, bytes.s_b2, bytes.s_b3, bytes.s_b4, ntohs(ipv4->sin_port),
+            providerResult, providerResult == 0 ? provider.szProtocol : "unavailable");
+        WSASetLastError(savedError);
+    }
+    const int result = connect(socket, address, length);
+    const int error = WSAGetLastError();
+    if (trace) DebugMessage("BUNS_RUNTIME client-socket-connect-return result=%d error=%d\n", result, error);
+    WSASetLastError(error);
+    return result;
+}
+
+static int TraceAsyncSelect(SOCKET socket, HWND window, u_int message, long events) {
+    const int result = WSAAsyncSelect(socket, window, message, events);
+    const int error = WSAGetLastError();
+    static volatile LONG count = 0;
+    if (InterlockedIncrement(&count) <= 16) DebugMessage("BUNS_RUNTIME client-socket-async-select result=%d error=%d\n", result, error);
+    WSASetLastError(error);
+    return result;
+}
